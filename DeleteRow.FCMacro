s = FreeCADGui.Selection.getCompleteSelection()
target=s[0].Object

#o=App.ActiveDocument.copyObject(target,True)

def getDeps(t):
	yield(t)
	for o in t.OutList:
		if 'Sketcher::SketchObject' == o.TypeId:
			yield o
		elif 'Part::Extrusion' == o.TypeId:
			yield o
			yield o.OutList[0]
			
copylist = [ i for i in getDeps(target) ]


for o in copylist:
	App.ActiveDocument.removeObject(o.Name)
	

