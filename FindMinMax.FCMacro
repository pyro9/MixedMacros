# find the peaks and troughs of a b-spline

#sample the bspline, at each point, compute the "down" vector. Either the reversed normal of the base points of the bspline, or 
#for periodic bSplines,a vector from the sample to tyhe CenterOfGravity of the shape.
#Take the Arc Cosine of the dot product of the vectors. It will = 90 degrees (1.5707963268 radians) exactly at a peak or a trough (local max or min).

from math import acos, pi

sel = Gui.Selection.getSelectionEx()[0]

e = sel.Object.Shape.__getattribute__(sel.SubElementNames[0])

deg90 = pi/2

cg=None
down=None

def computeDown(edge, start=None, end=None):	# it might accidentally compute UP, but that works the same for this purpose
	if start==None:
		start=edge.FirstParameter
	if end==None:
		end=edge.LastParameter

	mid = (start+end)/2

	v=edge.valueAt(start) - edge.valueAt(end)
	v2 = edge.valueAt(start)-edge.valueAt(mid)
	
	v3 = v.cross(v2)	# v3 is the hinge between the line to the end of the curve and to an arbitrary point on the curve
	
	vres = v3.cross(v)	# vres is the hinge between the baseline v and the hinge computed above.
						# It also happens to point down
	vres.normalize()
	
	# testing
	if False:
		vt = Part.Vertex(edge.valueAt(mid))
		l=vt.extrude(50*vres)
		Part.show(l).Label='Down'
		v4=edge.tangentAt(mid)
		l2=vt.extrude(10*v4)
		Part.show(l2).Label='Tangent'
	return vres
	
if e.isClosed():
	cg = e.CenterOfGravity	# Yeah, Yeah, globals are bad
else:	# for now, thi only works on the xy plane
	down = computeDown(e)

def Degrees(r):
	return r*180/pi
	
def Spaceship(test, standard, tolerance=0.0):
	if abs(test-standard) < tolerance:
		return 0
	return -1 if test<standard else 1               

def float_range(start, stop, step):
	current = start
	while current < stop:
		yield current
		current += step

def computeSlopeTheta(edge, p):
	point = edge.valueAt(p)
	tangent = edge.tangentAt(p)
	if cg:
		bv=point-cg
		bv.normalize()
	else:
#		bv = computeDown(edge, U=p)
		bv=down

	try:
		theta = acos(bv*tangent)
	except:
		print( "Math error:",bv, tangent)
	return theta
	

def findMinMax(edge, start, end, tol=0.0001, level=5):
	pLen = end-start
	lastP=start
	lastT = computeSlopeTheta(edge,start)
	res = Spaceship(lastT, deg90,tol)
	
#	print(f"MinMax enter: level: {level}, lastP:{lastP}, lastT: {lastT}, res: {res}")
		
	for p in float_range(start, end, pLen/1000):
		theta = computeSlopeTheta(edge, p)

		if not res:
			res = Spaceship(theta, deg90,tol)
			lastT = theta
			lastP = p
#			print(f"Skipping: p={p}, newres={res}")
			continue
			
		newres = Spaceship(theta, deg90, tol)
		if not newres:
				return p
				
#		print(f"MinMax progress: p:{p}, theta:{theta}, newres={newres}")
		if newres != res:
			level-=1
			if not level:
				return (lastP+p)/2
#				raise Exception("Recursion too deep")
			return findMinMax(edge, lastP, p, tol=tol, level=level)
		else:
			lastP=p
			lastT=theta
	print(f"MinMax returns: level: {level}, Start:{start}, End: {end}, lastP: {lastP}")
	return None

def findAllMinMax(edge, start, end, tol=0.0001, level=5):
	all = []
	p = start
	pStep = (edge.LastParameter - edge.FirstParameter)/1000
	
	theta = computeSlopeTheta(edge, p)
	if not Spaceship(theta, deg90, tol):
		all.append(p)
		
	while p+pStep < edge.LastParameter: #remember, floating point might approximate
		p = findMinMax(edge, p, edge.LastParameter, tol=tol, level=level)
		if p == None:
			break

		all.append(p)
		
	return all

params = findAllMinMax(e, e.FirstParameter,e.LastParameter, level=5, tol=0.01)
for p in params:
	if p!=None:
		print( (p, Degrees(computeSlopeTheta(e,p)) ))
	else:
		print(None)

pFactor = e.Length/( e.LastParameter - e.FirstParameter)
d = [ p*pFactor for p in params ]


vertices = [ Part.Vertex(e.valueAt(v)) for v in params ]
c=Part.makeCompound(vertices)
obj = Part.show(c)
obj.Label='MinMax'
obj.addProperty("App::PropertyFloatList", "Distances", "Result")
obj.Distances = d

