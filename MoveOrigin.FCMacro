sel = Gui.Selection.getSelectionEx()[0]

shp=sel.Object.Shape

if sel.SubElementNames:
	se=sel.SubElementNames[0]
	ix = int(se[4:])-1
	f=shp.Faces[ix]
	centerObject=False
else:
	f=shp
	ix=0
	centerObject=True

m=f.Placement.Matrix
sh2 = shp.transformGeometry(m.inverse())

if centerObject:
	f2=sh2
else:
	f2=sh2.Faces[ix]

m2=App.Matrix()
m2.move(f2.CenterOfGravity)

sh3=sh2.transformGeometry(m2.inverse())

# now place the selected face flat on the XY plane
if not centerObject:
	from math import acos
	f=sh3.Faces[ix]
	
	v=App.Vector(0,0,-1)
	n=f.normalAt(1,1)
	
	r=App.Rotation(n.cross(v), Radian=acos(n*v))
	m3=r.toMatrix()
	sh4=sh3.transformGeometry(m3)
else:
	sh4=sh3
	m3=App.Matrix()

obj=Part.show(sh4)
obj.Placement.Matrix=m*m2*m3.inverse()

#obj.Placement.Base=o
