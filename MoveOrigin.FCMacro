sel = Gui.Selection.getSelectionEx()[0]

shp=sel.Object.Shape

if sel.SubElementNames:
	se=sel.SubElementNames[0]
	ix = int(se[4:])-1
	f=shp.Faces[ix]
else:
	f=shp

o=f.CenterOfMass - sel.Object.Placement.Base
print("o=",o)
mv=App.Vector(0,0,0)-o
print("mv=",mv)
mat = App.Matrix()
mat.move(mv)
s = shp.transformGeometry(mat)
obj=Part.show(s)

obj.Placement.Base=o+sel.Object.Placement.Base
#obj.Placement.Base=o
